rules_version = '2';

/*
  Checkpoint — access rules.

  The role lives on the officer's own account document and is set by an admin.
  Nothing the browser sends can change it, so hiding a button in the UI is a
  convenience; this file is the actual boundary.
*/
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function email()     { return request.auth.token.email; }
    function account()   { return get(/databases/$(database)/documents/officers/$(email())).data; }
    // .get('role', 'officer') rather than .role: an account document that exists
    // without a role field made this expression error, and an erroring rule is
    // a denied rule - which locked the officer out of their own gate log.
    function role()      { return signedIn() && exists(/databases/$(database)/documents/officers/$(email()))
                             ? account().get('role', 'officer') : 'officer'; }
    function isOffice()  { return signedIn() && role() == 'office'; }
    function isOfficer() { return signedIn() && role() != 'office'; }

    // Delivery schedule: the receiving office publishes it, officers read it.
    match /orders/{id} {
      allow read:  if signedIn();
      allow write: if isOffice();
    }

    // Trailer blocks released for a yard check: office writes, officers read.
    match /yardslots/{id} {
      allow read:  if signedIn();
      allow write: if isOffice();
    }

    // Completed yard checks: officers record them. Nobody edits one afterwards;
    // a saved check is a record, so updates are refused outright.
    match /yardchecks/{id} {
      allow read:   if signedIn();
      allow create: if isOfficer();
      allow update: if false;
      allow delete: if isOffice();
    }

    // Seal verification forms.
    match /forms/{id} {
      allow read:   if signedIn();
      allow create: if isOfficer();
      allow update: if false;
      allow delete: if isOffice();
    }

    // Gate log rows. One continuous sheet: any officer on duty may complete any
    // row, because the trailer that booked in on the morning shift often leaves
    // on the evening one. Only the closing fields are writable, and the row
    // records which officer marked it out.
    match /logs/{id} {
      allow read:   if signedIn();
      allow create: if isOfficer();
      // A row a form created is that form's record: only the closing fields
      // move. A row the officer wrote by hand - the truck that arrives with
      // nothing and leaves with a trailer - is theirs to fill in and remove.
      allow update: if isOfficer()
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['timeout','outtrailer','outBy','outByName','outAt'])
                      || (resource.data.manual == true
                          && request.resource.data.manual == true
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['timein','timeout','carrier','tractor','trailer',
                                         'outtrailer','plate','state','notes',
                                         'outBy','outByName','outAt']))
                    )
                    // the closing officer is stamped by the app, not chosen
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['outBy'])
                        || request.resource.data.outBy == ''
                        || request.resource.data.outBy == email());
      allow delete: if isOffice()
                    || (isOfficer() && resource.data.manual == true
                        && resource.data.officer == email());
    }

    // Account documents carry the role, so only an admin may write them.
    // Officers may read their own to learn their name and role.
    match /officers/{id} {
      allow read:  if signedIn() && id == email();
      allow write: if false;
    }

    // Shared settings: office email, mailer URL, CC list.
    match /settings/{id} {
      allow read:  if signedIn();
      allow write: if isOffice();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
